# Copier en `.env` pour le développement local (`cp .env.example .env`).

# Base SQLite (libSQL). Chemin relatif à la racine du projet en dev.
# Créée automatiquement (tables comprises) au premier accès.
DATABASE_URL=file:local.db

# Sauvegarde automatique de la base (fichier local uniquement) : dossier (défaut :
# `backups/` à côté de la base), intervalle en heures (0 = désactivé), nombre conservé.
# BACKUP_DIR=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=30

# Jeton d'accès si DATABASE_URL pointe vers un serveur libSQL/Turso distant (sinon vide).
# DATABASE_AUTH_TOKEN=

# --- Production (adapter-node / Docker) ---
# URL publique de l'application : requise pour les formulaires (CSRF).
# ORIGIN=http://schemelect.local:3000
# Port d'écoute du serveur Node.
# PORT=3000
# Taille max. des requêtes (sauvegarde de gros projets). Défaut adapter-node : 512K.
# BODY_SIZE_LIMIT=50M
# Cookie de session `secure` : automatique en https, forçable avec true/false.
# COOKIE_SECURE=
